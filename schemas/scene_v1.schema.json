{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "toy_roadmark_detection/schemas/scene_v1.schema.json",
  "title": "SceneV1",
  "description": "Single source of truth for an editable toy roadmark scene. Row-major 4x4 matrices, meters, radians, ego frame x-forward y-left z-up.",
  "type": "object",
  "required": [
    "schema_version", "scene_id", "scene_group_id", "seed",
    "coordinate_frame", "units", "T_E_W", "bev_range", "ground",
    "objects", "lane_lines", "lanes", "arrows", "cameras", "render"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "scene_id": { "type": "string", "minLength": 1 },
    "scene_group_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "coordinate_frame": { "const": "ego_x_forward_y_left_z_up" },
    "units": {
      "type": "object",
      "required": ["length", "angle"],
      "properties": {
        "length": { "const": "m" },
        "angle": { "const": "rad" }
      }
    },
    "T_E_W": { "$ref": "#/definitions/mat4" },
    "bev_range": { "$ref": "#/definitions/bev_range" },
    "ground": {
      "type": "object",
      "required": ["size_x", "size_y", "color"],
      "properties": {
        "size_x": { "type": "number", "exclusiveMinimum": 0 },
        "size_y": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "grid_color": { "type": ["string", "null"] },
        "texture": { "type": ["string", "null"], "description": "reserved" }
      }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/definitions/object" }
    },
    "lane_lines": {
      "type": "array",
      "items": { "$ref": "#/definitions/lane_line" }
    },
    "lanes": {
      "type": "array",
      "items": { "$ref": "#/definitions/lane" }
    },
    "arrows": {
      "type": "array",
      "items": { "$ref": "#/definitions/arrow" }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/camera" }
    },
    "render": {
      "type": "object",
      "properties": {
        "light": {
          "type": "object",
          "properties": {
            "direction_ego": { "type": "array", "items": { "type": "number" } },
            "intensity": { "type": "number" },
            "ambient": { "type": "number" }
          }
        },
        "arrow_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "randomization": { "type": ["object", "null"] },
    "arrow_template_version": { "type": "string" }
  },
  "definitions": {
    "mat4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "array", "minItems": 4, "maxItems": 4,
        "items": { "type": "number" }
      }
    },
    "mat3": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "array", "minItems": 3, "maxItems": 3,
        "items": { "type": "number" }
      }
    },
    "bev_range": {
      "type": "object",
      "required": ["x_min", "x_max", "y_min", "y_max"],
      "properties": {
        "x_min": { "type": "number" },
        "x_max": { "type": "number" },
        "y_min": { "type": "number" },
        "y_max": { "type": "number" }
      }
    },
    "vec2": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "object": {
      "type": "object",
      "required": ["object_id", "shape", "center_ego", "yaw_rad"],
      "properties": {
        "object_id": { "type": "string", "minLength": 1 },
        "shape": { "enum": ["box", "cylinder", "car"] },
        "size_abc": { "$ref": "#/definitions/vec3", "description": "box: length(x) width(y) height(z); cylinder: [diameter, diameter, height]; car: body size" },
        "center_ego": { "$ref": "#/definitions/vec3" },
        "yaw_rad": { "type": "number" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "lane_line": {
      "type": "object",
      "required": ["line_id", "points_ego", "style", "width_m", "color"],
      "properties": {
        "line_id": { "type": "string", "minLength": 1 },
        "points_ego": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/vec3" } },
        "style": { "enum": ["solid", "dashed"] },
        "width_m": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "dash_length_m": { "type": "number" },
        "gap_length_m": { "type": "number" }
      }
    },
    "lane": {
      "type": "object",
      "required": ["lane_id", "centerline_ego", "width_m", "allowed_turns_slr", "world_rule_known"],
      "properties": {
        "lane_id": { "type": "string", "minLength": 1 },
        "centerline_ego": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/vec3" } },
        "width_m": { "type": "number", "exclusiveMinimum": 0 },
        "allowed_turns_slr": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 1 }
        },
        "world_rule_known": { "type": "boolean" },
        "rule_source": { "type": ["string", "null"] },
        "show_boundaries": { "type": "boolean" }
      }
    },
    "arrow": {
      "type": "object",
      "required": ["instance_id", "template_id", "class_id", "center_ego", "yaw_rad", "scale"],
      "properties": {
        "instance_id": { "type": "integer", "minimum": 1 },
        "template_id": { "type": "string", "minLength": 1 },
        "class_id": { "type": "integer", "minimum": 0, "maximum": 5 },
        "center_ego": { "$ref": "#/definitions/vec3" },
        "yaw_rad": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "lane_id": { "type": ["string", "null"] }
      }
    },
    "camera": {
      "type": "object",
      "required": ["camera_id", "width", "height", "K", "T_C_E", "near", "far"],
      "properties": {
        "camera_id": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "K": { "$ref": "#/definitions/mat3" },
        "T_C_E": { "$ref": "#/definitions/mat4" },
        "near": { "type": "number", "exclusiveMinimum": 0 },
        "far": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
